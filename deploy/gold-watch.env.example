# Required Telegram delivery settings
GOLD_TELEGRAM_BOT_TOKEN=
GOLD_TELEGRAM_CHAT_ID=

# Required safety interlocks. The worker refuses to start if these are changed.
GOLD_MODE=paper
LIVE_TRADING_ENABLED=false
MT5_TRADING_ENABLED=false

# Price-only data provider. This is not a broker and cannot place orders.
TWELVE_DATA_API_KEY=
GOLD_SYMBOL=XAU/USD
GOLD_INTERVAL=5min
GOLD_POLL_MS=300000
GOLD_MAX_BAR_AGE_MS=1200000

# Conservative headline monitor; it never opens a paper position.
GOLD_EVENT_ALERTS_ENABLED=true
GOLD_EVENT_POLL_MS=600000

# Paper account
PAPER_START_BALANCE_USD=100
GOLD_AUTO_PAPER_ENTRIES=false
GOLD_PAPER_RISK_PCT=0.01
GOLD_PAPER_DAILY_LOSS_USD=3
GOLD_MIN_CONFIDENCE=75
GOLD_BROKER_MIN_LOT=0.01
GOLD_CONTRACT_OZ_PER_LOT=100
GOLD_ESTIMATED_SPREAD_USD=0.35
GOLD_ESTIMATED_SLIPPAGE_USD=0.10
