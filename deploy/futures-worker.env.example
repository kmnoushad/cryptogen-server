# AWS ONLY: create /etc/nexio-futures.env, owner nexio, chmod 600.
# Use keys created inside a NEW dedicated subaccount, not the fade subaccount.
FUTURES_AUTO_ENVIRONMENT=testnet
ENABLE_FUTURES_AUTO=true
FUTURES_ACCOUNT_CONFIRMATION=SEPARATE_FUTURES_SUBACCOUNT
FUTURES_BINANCE_API_KEY=
FUTURES_BINANCE_API_SECRET=
# For live: environment=live and this exact acknowledgement:
FUTURES_AUTO_LIVE_ACKNOWLEDGEMENT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BOT_TOKEN=
OWNER_CHAT_ID=
# Optional; official calendars are attempted without a Finnhub key.
FINNHUB_KEY=
FUTURES_EVENT_GUARD_MANUAL=
